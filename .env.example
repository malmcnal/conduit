# Anthropic — console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Backends (configure any one; all optional with --skip-backend) ────────────
# Auto-detect priority when several are set: Airtable, Notion, monday.com

# Airtable — personal access token from airtable.com/create/tokens
# Scopes: data.records:read, data.records:write
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=Applications
AIRTABLE_VIEW_ID=

# Notion — internal integration secret from notion.so/profile/integrations
# Share the database with the integration (••• → Connections) first
NOTION_API_KEY=
NOTION_DATABASE_ID=

# monday.com — Profile → Developers → API token
MONDAY_API_KEY=
MONDAY_BOARD_ID=
